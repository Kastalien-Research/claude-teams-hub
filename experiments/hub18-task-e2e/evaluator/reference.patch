+  async function celldWorkspaceViews(): Promise<CelldWorkspaceView[]> {
+    const routes = (await registry.list()).filter(route => route.status === 'active');
+    const views = await Promise.all(
+      routes.map(async (route): Promise<CelldWorkspaceView | undefined> => {
+        try {
+          const snapshot = await transport.snapshot(route.workspaceId);
+          const state = snapshot.state as CellWorkspaceState | null;
+          if (state === null) return undefined;
+          return {
+            id: route.workspaceId,
+            name: state.workspace.name,
+            members: Object.keys(state.members),
+            problemCount: Object.keys(state.problems).length,
+          };
+        } catch {
+          return undefined;
+        }
+      }),
+    );
+    return views.filter((view): view is CelldWorkspaceView => view !== undefined);
+  }
