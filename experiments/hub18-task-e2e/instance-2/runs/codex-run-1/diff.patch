diff --git a/src/celld/workspace-state-reader.ts b/src/celld/workspace-state-reader.ts
new file mode 100644
index 0000000..feb338f
--- /dev/null
+++ b/src/celld/workspace-state-reader.ts
@@ -0,0 +1,74 @@
+/**
+ * Best-effort reads of every active celld workspace.
+ *
+ * The backend registry says which workspaces are routed; the cell snapshot is
+ * still the only state authority. All snapshots start together so one slow or
+ * unavailable cell costs one request window, rather than one window per
+ * workspace.
+ */
+
+import type { BackendRegistry } from './backend-registry.js';
+import type { CellTransport } from './client.js';
+import type { CellWorkspaceState } from './domain/state.js';
+
+export interface CelldWorkspaceStateRead {
+  workspaceId: string;
+  /** Undefined when the cell failed or did not return a workspace state. */
+  state: CellWorkspaceState | undefined;
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === 'object' && !Array.isArray(value);
+}
+
+/**
+ * Snapshot responses cross a process boundary, so the TypeScript type alone
+ * is not evidence that the body is a WorkspaceCell aggregate. Check the
+ * discriminator and the fields consumed by hub reads before exposing it.
+ */
+function isCellWorkspaceState(value: unknown, workspaceId: string): value is CellWorkspaceState {
+  if (!isRecord(value) || value.schemaVersion !== 'workspace-state-v1') return false;
+  if (!isRecord(value.workspace) || value.workspace.id !== workspaceId) return false;
+
+  const workspace = value.workspace;
+  const workspaceStringFields = ['id', 'name', 'description', 'createdBy', 'createdAt', 'updatedAt'];
+  if (workspaceStringFields.some(field => typeof workspace[field] !== 'string')) return false;
+
+  if (!isRecord(value.members)) return false;
+  for (const member of Object.values(value.members)) {
+    if (
+      !isRecord(member) ||
+      typeof member.agentId !== 'string' ||
+      (member.role !== 'coordinator' && member.role !== 'contributor') ||
+      typeof member.joinedAt !== 'string'
+    ) {
+      return false;
+    }
+  }
+
+  if (!isRecord(value.problems) || !isRecord(value.channels)) return false;
+  if (Object.values(value.channels).some(messages => !Array.isArray(messages))) return false;
+  return isRecord(value.intents) && isRecord(value.impacts) && isRecord(value.changes);
+}
+
+export async function readCelldWorkspaceStates(
+  registry?: BackendRegistry,
+  transport?: CellTransport,
+): Promise<CelldWorkspaceStateRead[]> {
+  if (registry === undefined || transport === undefined) return [];
+  const routes = (await registry.list()).filter(route => route.status === 'active');
+
+  return Promise.all(
+    routes.map(async (route): Promise<CelldWorkspaceStateRead> => {
+      try {
+        const snapshot = await transport.snapshot(route.workspaceId);
+        return {
+          workspaceId: route.workspaceId,
+          state: isCellWorkspaceState(snapshot.state, route.workspaceId) ? snapshot.state : undefined,
+        };
+      } catch {
+        return { workspaceId: route.workspaceId, state: undefined };
+      }
+    }),
+  );
+}
