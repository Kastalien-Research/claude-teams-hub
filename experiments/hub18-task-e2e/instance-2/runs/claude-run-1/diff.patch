+ * treated exactly like a cell that cannot be reached: the workspace is
+ * listed as unreachable rather than crashing the read on a missing field.
+ */
+export function isCellWorkspaceState(value: unknown): value is CellWorkspaceState {
+  if (value === null || typeof value !== 'object') return false;
+  const state = value as Partial<CellWorkspaceState>;
+  const workspace = state.workspace;
+  return (
+    workspace !== null &&
+    typeof workspace === 'object' &&
+    typeof workspace.id === 'string' &&
+    state.members !== null &&
+    typeof state.members === 'object' &&
+    !Array.isArray(state.members)
