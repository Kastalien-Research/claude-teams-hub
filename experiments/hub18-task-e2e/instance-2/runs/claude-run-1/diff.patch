+
+/**
+ * Snapshots every ACTIVE route concurrently. Probes never throw: an
+ * unreachable cell yields `state: null` for that route only, every other
+ * route is reported normally, and because the probes run in parallel the
+ * whole read takes about one cell request timeout no matter how many cells
+ * are slow or down. Result order follows the registry's route order.
+ */
+export async function probeCellWorkspaces(
+  registry: BackendRegistry,
+  transport: CellTransport,
+): Promise<CellWorkspaceProbe[]> {
+  const routes = (await registry.list()).filter(route => route.status === 'active');
+  return Promise.all(
+    routes.map(async (route): Promise<CellWorkspaceProbe> => {
+      try {
+        const snapshot = await transport.snapshot(route.workspaceId);
+        return { route, state: isCellWorkspaceState(snapshot.state) ? snapshot.state : null };
+      } catch {
+        return { route, state: null };
+      }
+    }),
+  );
+}
