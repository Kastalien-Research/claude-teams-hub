+/**
+ * One active celld route resolved against the cell that owns its workspace
+ * state. Global MCP reads and the HTTP read model both consume this view so
+ * workspace discovery cannot drift between the two surfaces.
+ */
+export type CelldWorkspaceRead =
+  | {
+      workspaceId: string;
+      snapshot: CellSnapshot;
+      state: CellWorkspaceState;
+    }
+  | {
+      workspaceId: string;
+      unreachable: true;
+    };
+
+export async function readCelldWorkspaces(
+  registry: BackendRegistry,
+  transport: CellTransport,
+): Promise<CelldWorkspaceRead[]> {
+  const routes = (await registry.list()).filter(route => route.status === 'active');
+  const reads: CelldWorkspaceRead[] = [];
+  for (const route of routes) {
+    try {
+      const snapshot = await transport.snapshot(route.workspaceId);
+      const state = snapshot.state as CellWorkspaceState | null;
+      if (state === null) continue;
+      reads.push({ workspaceId: route.workspaceId, snapshot, state });
+    } catch {
+      // The route still establishes that this is a celld workspace even when
+      // its authoritative state cannot currently be reached.
+      reads.push({ workspaceId: route.workspaceId, unreachable: true });
+    }
+  }
+  return reads;
+}
