# Dependencies
node_modules/

# Build output
dist/

# Environment
.env
.env.local
.env.*.local

# Runtime data (the server is the only sanctioned writer; see .claude/hooks)
.team-hub/

# MCP client configs may carry keys
.mcp.json

# Python test droppings (hooks suite)
__pycache__/
.pytest_cache/

# Throwaway local hub state from probes/smokes
.tmp-hubdata/

# Vendored read-only reference checkouts (root-level only; src/references is code)
/references/

# Logs and editor droppings
*.log
.DS_Store
*.swp
*~

# Claude Code machine-local state
.claude/settings.local.json
.claude/state/
